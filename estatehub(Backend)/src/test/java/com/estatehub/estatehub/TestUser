package com.estatehub.estatehub;

import com.estatehub.estatehub.Controller.UserController;
import com.estatehub.estatehub.DTO.UserDTO;
import com.estatehub.estatehub.Service.SecurityService;

import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.webmvc.test.autoconfigure.WebMvcTest;
import org.springframework.test.context.bean.override.mockito.MockitoBean;
import org.springframework.test.web.servlet.MockMvc;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.when;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

@WebMvcTest(UserController.class)
class TestUser {

    @Autowired
    private MockMvc mockMvc;

    @MockitoBean
    private SecurityService securityService;

    @Test
    void registerUserSuccessfully() throws Exception {

        UserDTO response = new UserDTO(
                1,
                "Saeed",
                "saeed.test@gmail.com",
                "encodedPassword",
                "USER"
        );

        when(securityService.addUser(any(UserDTO.class)))
                .thenReturn(response);

        mockMvc.perform(post("/adduser")
                        .contentType("application/json")
                        .content("""
                                {
                                    "name": "Saeed",
                                    "email": "saeed.test@gmail.com",
                                    "password": "Saeed@123",
                                    "role": "USER"
                                }
                                """))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id").value(1))
                .andExpect(jsonPath("$.name").value("Saeed"))
                .andExpect(jsonPath("$.email")
                        .value("saeed.test@gmail.com"))
                .andExpect(jsonPath("$.role").value("USER"))
                .andExpect(jsonPath("$.password")
                        .value("encodedPassword"));
    }

    @Test
    void registerUserWithInvalidEmail() throws Exception {

        mockMvc.perform(post("/adduser")
                        .contentType("application/json")
                        .content("""
                                {
                                    "name": "Saeed",
                                    "email": "invalid-email",
                                    "password": "Saeed@123",
                                    "role": "USER"
                                }
                                """))
                .andExpect(status().isBadRequest());
    }
}